"use strict";

const employees = [
    { name: "Amit", salary: "45000", years: "5" },
    { name: "Sara", salary: "38000", years: "2" },
    { name: "Kiran", salary: "52000", years: "7" }
];

for (let emp of employees) {
    try {
        // --- Validation ---
        if (!emp.name || !emp.salary || !emp.years) {
            throw new Error("Missing employee property!");
        }

        // --- Convert string to numbers ---
        let salary = Number(emp.salary);
        let years = Number(emp.years);

        if (isNaN(salary) || isNaN(years)) {
            throw new Error(`Invalid numeric value for ${emp.name}`);
        }

        // --- Bonus calculation ---
        let bonus = (years > 3) ? salary * 0.1 : salary * 0.05;

        // --- Template String Output ---
        console.log(`
==========================
Employee: ${emp.name}
Salary: ₹${salary}
Years of Experience: ${years}
Bonus Earned: ₹${bonus}
==========================
        `);

    } catch (error) {
        console.log(`Error for ${emp.name}: ${error.message}`);
    }
}
