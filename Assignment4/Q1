
// Q1: E-Commerce Product Manager (Classes + Objects)

class Product {
    constructor(id, name, price, category) {
        this.id = id;
        this.name = name;
        this.price = price;
        this.category = category;
    }

    applyDiscount(discountPercent) {
        this.price = this.price - (this.price * (discountPercent / 100));
    }

    // Method to return formatted product details
    getDetails() {
        return `ID: ${this.id}, Name: ${this.name}, Price: ₹${this.price}, Category: ${this.category}`;
    }
}


const products = [
    new Product(1, "Laptop", 50000, "Electronics"),
    new Product(2, "Shoes", 1500, "Fashion"),
    new Product(3, "Smartphone", 20000, "Electronics"),
    new Product(4, "Book", 300, "Stationery"),
];

products[0].applyDiscount(10);  // 10% off on Laptop
products[2].applyDiscount(5);   // 5% off on Smartphone


const expensiveProducts = products.filter(product => product.price > 1000);

console.log("Products priced above ₹1000:");
expensiveProducts.forEach(product => {
    console.log(product.getDetails());
});
