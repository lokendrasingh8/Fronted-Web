<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>

    
    <style>
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #222;
            display: flex;
            flex-direction: column;
        }

       
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #333;
            color: white;
            padding: 1rem 2rem; /* rem unit */
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
        }

        header .logo {
            font-size: 1.5em; /* em unit */
            font-weight: bold;
        }

        header nav a {
            color: white;
            margin-left: 1.5rem;
            text-decoration: none;
            font-size: 1rem;
        }

        header nav a:hover {
            text-decoration: underline;
        }

        
        main {
            padding-top: 80px;
            flex: 1;
        }

        .bio {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 5vh 10%; 
            gap: 2rem;
        }

        .profile-img {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            border: 4px solid #333;
        }

        .bio-text h1 {
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .bio-text p {
            font-size: 1rem;
            line-height: 1.5;
            max-width: 500px;
        }

        
        .about, .contact {
            padding: 5vh 10%;
            text-align: center;
            background-color: #fff;
            margin-top: 2rem;
            border-top: 2px solid #333;
        }

        .about h2, .contact h2 {
            font-size: 1.8rem;
            margin-bottom: 1rem;
        }

        /* === Footer === */
        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 1rem;
            margin-top: auto; 
        }
    </style>
</head>
<body>

   
    <header>
        <div class="logo">LOKENDRA YADAV</div>
        <nav>
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    
    <main id="home">
        <section class="bio">
            <img src="https://via.placeholder.com/200" alt="Profile Image" class="profile-img">
            <div class="bio-text">
                <h1>Hello, I'm LOKENDRA YADAV</h1>
                <p>
                    I am a passionate web developer who loves creating beautiful and functional websites.
                    Welcome to my personal portfolio! Scroll down to know more about me.
                </p>
            </div>
        </section>
    </main>

   
    <section id="about" class="about">
        <h2>About Me</h2>
        <p>
            I specialize in front-end development with HTML, CSS, and JavaScript. 
            I enjoy turning complex problems into simple, elegant solutions.
        </p>
    </section>

   
    <section id="contact" class="contact">
        <h2>Contact</h2>
        <p>Email: yLOKENDRA@example.com</p>
    </section>

    <!-- FOOTER SECTION -->
    <footer>
        <p>&copy; 2025 Your Name. All Rights Reserved.</p>
    </footer>

</body>
</html>
